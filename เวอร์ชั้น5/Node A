bool isDuplicate(String msgId) {
  for (const auto& id : seenMsgIDs) {
    if (id == msgId) return true;
  }
  if (seenMsgIDs.size() >= 50) seenMsgIDs.erase(seenMsgIDs.begin());
  seenMsgIDs.push_back(msgId);
  return false;
}

